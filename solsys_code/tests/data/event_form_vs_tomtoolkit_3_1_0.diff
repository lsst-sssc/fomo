+{% else %}
+<div id="cal-event-card">
+  <dl class="row mb-2">
+    <dt class="col-sm-3">Title</dt>
+    <dd class="col-sm-9">{{ event.title }}</dd>
+    <dt class="col-sm-3">Start</dt>
+    <dd class="col-sm-9">{{ event.start_time|date:'Y-m-d H:i' }} UTC</dd>
+    <dt class="col-sm-3">End</dt>
+    <dd class="col-sm-9">{{ event.end_time|date:'Y-m-d H:i' }} UTC</dd>
+    {% if event.description %}
+    <dt class="col-sm-3">Description</dt>
+    <dd class="col-sm-9">{{ event.description|linebreaksbr }}</dd>
+    {% endif %}
+    {% if event.url %}
+    <dt class="col-sm-3">URL</dt>
+    <dd class="col-sm-9">
+      {% if event.url|is_web_url %}
+      <a href="{{ event.url }}" target="_blank" rel="noopener noreferrer">View ↗</a>
+      {% else %}
+      <span class="text-muted">(not a web link)</span>
+      {% endif %}
+    </dd>
+    {% endif %}
+    {% if event.target_list %}
+    <dt class="col-sm-3">Target list</dt>
+    <dd class="col-sm-9">
+      <a href="{% url 'targets:list' %}?targetlist__name={{ event.target_list.id }}" target="_blank">{{ event.target_list.name }} ↗</a>
+    </dd>
+    {% endif %}
+    {% if event.user %}
+    <dt class="col-sm-3">User</dt>
+    <dd class="col-sm-9">{{ event.user }}</dd>
+    {% endif %}
