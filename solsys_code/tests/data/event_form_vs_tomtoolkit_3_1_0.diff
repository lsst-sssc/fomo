+    <dt class="col-sm-3">Proposal</dt>
+    <dd class="col-sm-9">{{ event.proposal }}</dd>
+    {% endif %}
+    {% if event.telescope %}
+    <dt class="col-sm-3">Telescope</dt>
+    <dd class="col-sm-9">{{ event.telescope }}</dd>
+    {% endif %}
+    {% if event.instrument %}
+    <dt class="col-sm-3">Instrument</dt>
